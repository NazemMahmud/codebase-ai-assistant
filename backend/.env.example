# API
API_PORT=8000
APP_ENV='development' # stage; production; qa

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codedoc

# Set by docker-compose for the api service; override for local (non-docker) runs
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codedoc

# Embeddings (local, retrieval needs no API key). 768-dim; loads with trust_remote_code.
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# LLM generation (BYOK)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-26b-a4b-it:free # you may choose other
LLM_API_KEY=

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
