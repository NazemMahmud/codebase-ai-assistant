# API
API_PORT=8000

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=codedoc

# Set by docker-compose for the api service; override for local (non-docker) runs
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/codedoc

# Embeddings (retrieval needs no API key)
EMBEDDING_MODEL=

# LLM generation (BYOK)
LLM_PROVIDER=openrouter
LLM_MODEL=
LLM_API_KEY=

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
